<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ELARA</RootNamespace>
    <AssemblyName>ELARA</AssemblyName>
    <Title>ELARA</Title>
    <Product>ELARA</Product>
    <Description>Easy Local Audio Recording App</Description>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationIcon>assets/elara.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="assets/elara.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE-DOTNET-LIBRARY.txt" CopyToOutputDirectory="PreserveNewest" Link="LICENSE-DOTNET-LIBRARY.txt" />
  </ItemGroup>
</Project>
